<style>
.sa-filters{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:flex-end;background:#fafbfc;border:1px solid #e2e5e9;border-radius:8px;padding:10px 14px;margin:8px 0 12px}
.sa-filters .f{display:flex;flex-direction:column;gap:2px}
.sa-filters label{font-size:11px;color:#5b6570;font-weight:bold;text-transform:uppercase;letter-spacing:.03em}
.sa-filters select,.sa-filters input[type=date]{border:1px solid #cfd4d9;border-radius:6px;padding:4px 8px;font-size:13px;background:#fff;max-width:190px}
.sa-filters .actions{display:flex;gap:8px;align-items:center}
.sa-btn{border:1px solid #1f6feb;background:#1f6feb;color:#fff;border-radius:6px;padding:5px 14px;font-size:13px;cursor:pointer;font-weight:600}
.sa-btn:hover{background:#1a5fd0}
.sa-btn.secondary{background:#fff;color:#1f6feb}
.sa-btn.secondary:hover{background:#eef4ff}
</style>
<h2>Service Assurance</h2>
<%= form_tag('/service_assurance', method: :get, id: 'sa-filter-form') do %>
<div class="sa-filters">
  <div class="f"><label>Estado</label>
  <%= select_tag 'sa_status', options_for_select([['Abiertos (pendientes + en curso)', '']] + ServiceAssuranceCase::STATUSES.map { |s| [s, s] }, @status_filter) %></div>
  <div class="f"><label>Carrier</label>
  <%= select_tag 'sa_carrier', options_for_select([['— todos —', '']] + @carrier_options.map { |c| [c, c] }, @carrier_filter) %></div>
  <div class="f"><label>Evaluador</label>
  <%= select_tag 'sa_eval', options_for_select([['— todos —', '']] + @evaluator_options, @eval_filter) %></div>
  <div class="f"><label>Desde</label>
  <%= date_field_tag 'sa_from', @from %></div>
  <div class="f"><label>Hasta</label>
  <%= date_field_tag 'sa_to', @to %></div>
  <div class="actions">
  <%= submit_tag 'Filtrar', name: nil, class: 'sa-btn secondary' %>
  <button type="button" class="sa-btn" id="sa-export-btn">Exportar XLSX</button>
  </div>
</div>
<% end %>
<script>
document.getElementById('sa-export-btn').addEventListener('click',function(){
  var f=document.getElementById('sa-filter-form');
  var q=function(n){var el=f.querySelector('[name='+n+']');return el?encodeURIComponent(el.value):'';};
  location.href='/service_assurance/cases/export?sa_from='+q('sa_from')+'&sa_to='+q('sa_to')+'&sa_carrier='+q('sa_carrier');
});
</script>
<% if @issues.nil? %>
  <p class="nodata">Configure el campo de activación en Administración → ajustes del plugin.</p>
<% elsif @issues.empty? %>
  <p class="nodata">Sin casos para este filtro.</p>
<% else %>
  <span class="pagination"><%= pagination_links_full(@paginator, @issue_count) %></span>
  <table class="list issues">
    <thead><tr><th>#</th><th>Asunto</th><th>Proyecto</th><th>Cerrado</th><th>Antig.</th><th>Estado</th><th>Carrier</th><th>Indisponibilidad</th><th>Evaluador</th><th></th></tr></thead>
    <tbody>
    <% @issues.each do |issue| %>
      <% sa = @case_by_issue[issue.id] %>
      <tr>
        <td><%= link_to issue_folio(issue), issue_path(issue) %></td>
        <td><%= issue.subject %></td>
        <td><%= issue.project.name %></td>
        <td><%= format_time(issue.closed_on) %></td>
        <td><%= sa && sa.age_days ? "#{sa.age_days}d" : '—' %></td>
        <td><%= sa ? sa_status_label(sa.status) : sa_status_label('pendiente') %></td>
        <td><%= sa&.evaluation&.provider || '—' %></td>
        <td><%= sa && sa.evaluation ? sa_downtime_label(sa.evaluation.downtime_minutes) : '—' %></td>
        <td><%= sa ? assignee_name(sa) : '—' %></td>
        <td>
          <% if sa %>
            <%= link_to 'Abrir', service_assurance_case_path(sa), class: 'icon icon-edit' %>
          <% else %>
            <%= form_tag('/service_assurance/cases/open', method: :post, style: 'display:inline') do %>
              <%= hidden_field_tag 'issue_id', issue.id %>
              <%= submit_tag('Evaluar', class: 'button-small') %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
  <span class="pagination"><%= pagination_links_full(@paginator, @issue_count) %></span>
<% end %>
