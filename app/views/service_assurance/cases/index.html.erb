<h2>Service Assurance</h2>
<%= form_tag('/service_assurance', method: :get) do %>
  <label>Estado</label>
  <%= select_tag 'sa_status', options_for_select([['Abiertos (pendientes + en curso)', '']] + ServiceAssuranceCase::STATUSES.map { |s| [s, s] }, @status_filter) %>
  <label>Carrier</label>
  <%= text_field_tag 'sa_carrier', @carrier_filter, size: 15 %>
  <label>Evaluador (id)</label>
  <%= text_field_tag 'sa_eval', @eval_filter, size: 6 %>
  <label>Desde</label>
  <%= date_field_tag 'sa_from', @from %>
  <label>Hasta</label>
  <%= date_field_tag 'sa_to', @to %>
  <%= submit_tag 'Filtrar', name: nil %>
  <%= link_to 'Exportar XLSX (periodo)', "/service_assurance/cases/export?sa_from=#{@from}&sa_to=#{@to}&sa_carrier=#{@carrier_filter}", class: 'icon icon-excel' %>
<% end %>
<% if @issues.nil? %>
  <p class="nodata">Configure el campo de activación en Administración → ajustes del plugin.</p>
<% elsif @issues.empty? %>
  <p class="nodata">Sin casos para este filtro.</p>
<% else %>
  <span class="pagination"><%= pagination_links_full(@paginator, @issue_count) %></span>
  <table class="list issues">
    <thead><tr><th>#</th><th>Asunto</th><th>Proyecto</th><th>Cerrado</th><th>Antig.</th><th>Estado SA</th><th>Carrier</th><th>Evaluador</th><th></th></tr></thead>
    <tbody>
    <% @issues.each do |issue| %>
      <% sa = @case_by_issue[issue.id] %>
      <tr>
        <td><%= link_to issue_folio(issue), issue_path(issue) %></td>
        <td><%= issue.subject %></td>
        <td><%= issue.project.name %></td>
        <td><%= format_time(issue.closed_on) %></td>
        <td><%= sa && sa.age_days ? "#{sa.age_days}d" : '—' %></td>
        <td><%= sa ? sa.status : 'pendiente por evaluar' %></td>
        <td><%= sa&.evaluation&.provider || '—' %></td>
        <td><%= sa&.assignee ? sa.assignee.login : '—' %></td>
        <td>
          <% if sa %>
            <%= link_to 'Abrir', service_assurance_case_path(sa), class: 'icon icon-edit' %>
          <% else %>
            <%= form_tag('/service_assurance/cases/open', method: :post, style: 'display:inline') do %>
              <%= hidden_field_tag 'issue_id', issue.id %>
              <%= submit_tag('Evaluar', class: 'button-small') %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
  <span class="pagination"><%= pagination_links_full(@paginator, @issue_count) %></span>
<% end %>
