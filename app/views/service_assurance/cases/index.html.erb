<h2>Service Assurance — Bandeja</h2>
<% if @issues.nil? %>
  <p class="nodata">Configure el campo de activación en Administración → ajustes del plugin.</p>
<% elsif @issues.empty? %>
  <p class="nodata">Sin casos cerrados con valor afirmativo.</p>
<% else %>
  <p><em><%= @total %> caso(s) elegible(s). Se muestran hasta 100 por página, ordenados por cierre reciente.</em></p>
  <table class="list issues">
    <thead><tr><th>#</th><th>Asunto</th><th>Proyecto</th><th>Cerrado</th><th>Estado SA</th><th></th></tr></thead>
    <tbody>
    <% @issues.each do |issue| %>
      <% sa = @case_by_issue[issue.id] %>
      <tr>
        <td><%= link_to "##{issue.id}", issue_path(issue) %></td>
        <td><%= issue.subject %></td>
        <td><%= issue.project.name %></td>
        <td><%= format_time(issue.closed_on) %></td>
        <td><%= sa ? sa.status : '—' %></td>
        <td>
          <% if sa %>
            <%= link_to 'Abrir', service_assurance_case_path(sa), class: 'icon icon-edit' %>
          <% else %>
            <%= form_tag('/service_assurance/cases/open', method: :post, style: 'display:inline') do %>
              <%= hidden_field_tag 'issue_id', issue.id %>
              <%= submit_tag('Evaluar', class: 'button-small') %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% end %>
