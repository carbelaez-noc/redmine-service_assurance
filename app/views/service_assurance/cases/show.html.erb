<style>
.sa-tabbar{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0}
.sa-tabbar button{padding:6px 12px;border:1px solid #d5d9de;border-radius:7px;background:#f7f8f9;cursor:pointer;font-size:13px;color:#444;font-weight:600}
.sa-tabbar button.todo{background:#f8d7da;border-color:#f2b8c1;color:#721c24}
.sa-tabbar button.ok{background:#d9ead3;border-color:#b6d7a8;color:#274e13}
.sa-tabbar button.active{box-shadow:inset 0 3px 0 #2b7cd3}
.sa-panel{display:none;padding:10px 2px}
.sa-panel.active{display:block}
.sa-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:8px 16px}
.sa-grid .full{grid-column:1/-1}
.sa-grid label{display:block;font-weight:bold;margin-bottom:2px}
.sa-grid input,.sa-grid select,.sa-grid textarea{width:100%;max-width:100%;box-sizing:border-box}
.sa-grid input[readonly]{background:#f4f4f4}
.sa-calc{font-size:12.5px;color:#5b6570;margin:6px 0}
.sa-calc strong{color:#111}
.sa-journal{margin:6px 0;border:1px solid #e0e0e0;border-radius:4px}
.sa-journal summary{cursor:pointer;padding:4px 8px;background:#f7f7f7}
.sa-journal .wiki{padding:4px 8px}
.sa-snap{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:6px 16px;margin:8px 0}
.sa-snap div{border-bottom:1px dotted #e0e0e0;padding:3px 0}
.sa-snap span{display:block;font-size:10.5px;color:#5b6570;font-weight:bold;text-transform:uppercase;letter-spacing:.03em}
.sa-snap .full{grid-column:1/-1}
.sa-cierre{grid-template-columns:repeat(3,1fr);border-top:2px solid #e2e5e9;padding-top:6px}
.sa-fila3{grid-template-columns:repeat(3,1fr)}
.sa-line{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0}
.sa-line>div{background:#f4f6f9;border-radius:10px;padding:7px 14px;flex:1 1 150px;max-width:100%}
.sa-line>div span{display:block;font-size:10px;color:#8a94a0;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:1px}
.sa-line>div{font-size:13px;color:#111}
.sa-topbar{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap}
.sa-topbar .sa-flow{margin:0;padding:0;border:none}
.sa-flow{margin-top:10px;padding-top:8px;border-top:1px solid #ddd;display:flex;gap:6px;flex-wrap:wrap;align-items:center;justify-content:flex-end}
.sa-flow .sa-btn{font-size:12.5px;padding:4px 12px;border-radius:6px;border:1px solid #cfd4d9;background:#fff;cursor:pointer}
.sa-flow .sa-btn.primary{background:#1f6feb;border-color:#1f6feb;color:#fff;font-weight:600}
.sa-flow .sa-btn.primary:hover{background:#1a5fd0}
.sa-flow .sa-btn:hover{background:#eef4ff}
.sa-flow .sa-btn.danger{color:#b3261e}
.sa-flow .sa-btn.go{background:#2e7d32;border-color:#2e7d32;color:#fff;font-weight:600}
.sa-flow .sa-btn.go:hover{background:#256a29}
.sa-mini{border:1px solid #cfd4d9;background:#fff;border-radius:4px;padding:1px 5px;cursor:pointer;font-size:12px;line-height:1.2}
.sa-mini:hover{background:#eef4ff}
#sa-saved{color:#155724;font-weight:bold}
dialog.sa-dlg{border:1px solid #cfd4d9;border-radius:10px;padding:18px 20px;max-width:420px;box-shadow:0 8px 30px rgba(0,0,0,.18)}
dialog.sa-dlg::backdrop{background:rgba(20,30,45,.45)}
dialog.sa-dlg h3{margin:0 0 8px;font-size:15px}
dialog.sa-dlg label{display:block;font-size:11px;color:#5b6570;font-weight:bold;text-transform:uppercase;letter-spacing:.03em;margin:8px 0 2px}
dialog.sa-dlg input,dialog.sa-dlg textarea{width:100%;box-sizing:border-box;border:1px solid #cfd4d9;border-radius:6px;padding:5px 8px;font-size:13px}
dialog.sa-dlg menu{display:flex;gap:8px;justify-content:flex-end;padding:12px 0 0;margin:0}
.sa-subnav{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}
.sa-subnav a{display:inline-block;padding:4px 12px;border:1px solid #cfd4d9;border-radius:6px;background:#fff;text-decoration:none;font-size:12.5px;color:#1f6feb;font-weight:600}
.sa-subnav a:hover{background:#eef4ff;text-decoration:none}
@media (max-width:800px){.sa-grid{grid-template-columns:1fr}.sa-cierre,.sa-fila3{grid-template-columns:1fr 1fr}}
</style>
<h2>Service Assurance — Caso #<%= @sa_case.id %> (ticket <%= link_to issue_folio(@issue), issue_path(@issue) %>)</h2>
<div class="sa-subnav"><%= link_to '← Volver a la bandeja', service_assurance_path %> <%= link_to 'Ver todos los casos', '/service_assurance?sa_status=' %> <%= link_to 'Abrir ticket en otra pestaña', issue_path(@issue), target: '_blank' %> <a href="#" id="sa-audit-toggle">Ver auditoría</a></div>
<div class="sa-snap">
  <div class="full"><span>Ticket</span><%= link_to issue_folio(@issue), issue_path(@issue) %> — <%= @issue.subject %></div>
  <div><span>Estado</span><%= sa_status_label(@sa_case.status) %></div>
  <div><span>Evaluador</span><%= assignee_name(@sa_case) %></div>
  <div><span>Antigüedad</span><%= @sa_case.age_days ? "#{@sa_case.age_days} días" : '—' %></div>
</div>

<% snap = @sa_case.original_snapshot || {} %>
<%= form_for :evaluation, url: "/service_assurance/cases/#{@sa_case.id}", html: { method: :patch, id: 'sa-form', 'data-ticket-start' => snap.dig('inicio', 'raw').to_s, 'data-ticket-end' => snap.dig('fin', 'raw').to_s } do |f| %>
<%= f.hidden_field :lock_version, value: @evaluation.lock_version, id: 'ev-lock' %>
<% flow = (ServiceAssurance::CasesController::TRANSITION_FLOW[@sa_case.status] || []) %>
<div class="sa-topbar">
<div class="sa-tabbar">
<button type="button" data-tab="panel-a" class="<%= @tab_states[:a] ? 'ok' : 'todo' %> active">A. Ticket</button>
<button type="button" data-tab="panel-b" class="<%= @tab_states[:b] ? 'ok' : 'todo' %>">B. Evaluación y contractual</button>
<% if %w[por_conciliar conciliado].include?(@sa_case.status) %><button type="button" data-tab="panel-d" class="<%= @tab_states[:d] ? 'ok' : 'todo' %>">C. Conciliación</button><% end %>
</div>
<div class="sa-flow">
<input type="hidden" name="transition" id="sa-transition" value="save">
<% if flow.include?('save') %><button type="submit" class="sa-btn primary" data-t="save">Guardar avance</button><% end %>
<% if flow.include?('to_conciliate') && @can_conciliate %><button type="submit" class="sa-btn" data-t="to_conciliate">Enviar a conciliación</button><% end %>
<% if flow.include?('discard') %><button type="button" class="sa-btn danger" id="btn-discard">No aplica</button><% end %>
<% if flow.include?('close_accepted') && @can_conciliate %><button type="button" class="sa-btn" id="btn-accept">Cerrar: reconocida</button><% end %>
<% if flow.include?('close_rejected') && @can_conciliate %><button type="button" class="sa-btn danger" id="btn-reject">Cerrar: rechazada</button><% end %>
<span id="sa-saved"></span>
</div>
</div>

<section class="sa-panel active" id="panel-a">
<h3>A. Información original del ticket</h3>
  <p><strong>Asunto:</strong> <%= @issue.subject %></p>
  <% if snap.any? %>
  <% line = { 'ciudad' => 'Ciudad', 'inicio' => 'Inicio de falla', 'fin' => 'Fin de falla', 'clientes' => 'Clientes afectados', 'motivo_apertura' => 'Motivo de apertura', 'carrier' => 'Carrier', 'caso_isp' => '# Caso ISP', 'id_externo' => 'ID externo', 'categoria' => 'Categoría de cierre', 'subcategoria' => 'Subcategoría de cierre', 'motivo' => 'Motivo de cierre' } %>
  <div class="sa-line">
    <% line.each do |key, label| %>
      <% raw = snap.dig(key, 'raw') %>
      <div><span><%= label %></span><%= FibrazoServiceAssurance::PreloadMap.display(raw) %></div>
    <% end %>
  </div>
  <% end %>
  <p><strong>Descripción:</strong></p>
  <div class="wiki"><%= textilizable(@issue.description) %></div>
  <p><%= link_to 'Ver notas y avances en el ticket →', issue_path(@issue), target: '_blank' %>
  <% if @attachments.any? %>
  · <strong>Adjuntos (<%= @attachments.size %>):</strong>
  <% @attachments.each do |a| %><%= link_to a.filename, attachment_path(a) %> <% end %></p>
  <% end %>
</section>

<section class="sa-panel" id="panel-b">
<h3>B. Evaluación y datos contractuales</h3>
<div class="sa-calc">A objetar: <strong id="calc-contract">—</strong> (<strong id="calc-contract-h">—</strong>) · Clientes: <strong><%= @evaluation.affected_customers || '—' %></strong></div>
<div class="sa-grid">
  <div><label>Proveedor (inventario carrier)</label><%= f.select :provider, [['— seleccionar —', '']] + @carriers.map { |c| [c, c] }, selected: @evaluation.provider %></div>
  <div><label>Número de escalamiento carrier *</label><%= f.text_field :external_case, value: @evaluation.external_case, required: true %></div>
  <div><label>ID del servicio *</label><%= f.text_field :service_id, value: @evaluation.service_id, required: true %></div>
  <div><label>Tipo de afectación</label><%= f.select :impact_type, [['— seleccionar —', '']] + (['Falla total', 'Degradación', 'Intermitencia', 'Sin afectación'] | [@evaluation.impact_type.to_s]).reject(&:empty?).map { |v| [v, v] }, selected: @evaluation.impact_type %></div>
  <div><label>Clientes afectados</label><%= f.number_field :affected_customers, value: @evaluation.affected_customers %></div>
  <div><label>¿Aplica ANS?</label><%= f.select :ans_applies, [['—', ''], ['Sí', true], ['No', false]], selected: @evaluation.ans_applies.nil? ? '' : @evaluation.ans_applies %></div>
  <div><label>Fecha reporte carrier</label><%= f.date_field :reported_on, value: @evaluation.reported_on %></div>
  <div><label>Inicio a objetar</label>
    <%= f.datetime_field :contract_start_at, value: @evaluation.contract_start_at, id: 'ev-contract-start' %></div>
  <div><label>Fin a objetar</label>
    <%= f.datetime_field :contract_end_at, value: @evaluation.contract_end_at, id: 'ev-contract-end' %></div>
  <div><label>Indisponibilidad (min)</label><%= f.number_field :downtime_minutes, value: @evaluation.downtime_minutes, id: 'ev-downtime', readonly: true %></div>
  <div><label>&nbsp;</label><button type="button" class="sa-mini" id="pull-both" title="Traer inicio y fin de falla del ticket">↙ Traer fechas del ticket</button></div>
  <div class="full"><label>Observaciones</label><%= f.text_area :observations, value: @evaluation.observations, rows: 4 %></div>
</div>
<p class="sa-hint">* El escalamiento es obligatorio para avanzar. Las fechas no aceptan futuro ni anteriores al inicio de la falla.</p>
</section>

<% if %w[por_conciliar conciliado].include?(@sa_case.status) %>
<section class="sa-panel" id="panel-d">
<h3>C. Conciliación</h3>
<% if @evaluation.conciliation_applies != true %>
<div class="sa-calc">La conciliación se habilita al marcar <strong>¿Aplica ANS? = Sí</strong> en la pestaña B.</div>
<% end %>
<div class="sa-calc">Diferencia (computable − reconocido): <strong id="calc-diff">—</strong> · Se calcula sola al guardar.</div>
<div class="sa-grid">
  <div><label>Tiempos reconocidos (min)</label><%= f.number_field :acknowledged_minutes, value: @evaluation.acknowledged_minutes, id: 'ev-ack' %></div>
  <div><label>Diferencia (min)</label><%= f.number_field :difference_minutes, value: @evaluation.difference_minutes, id: 'ev-diff', readonly: true %></div>
  <div><label>Créditos reconocidos</label><%= f.number_field :credit_granted, value: @evaluation.credit_granted, step: 0.01 %></div>
  <div><label>Resultado</label><strong><%= @evaluation.result.presence || 'pendiente' %></strong></div>
  <div class="full"><label>Motivo / observaciones de cierre</label><%= f.text_area :conciliation_notes, value: @evaluation.conciliation_notes, rows: 3 %></div>
</div>
</section>
<% end %>

<% flow = (ServiceAssurance::CasesController::TRANSITION_FLOW[@sa_case.status] || []) %>
<% if @sa_case.final? %>
<div class="sa-flow">
  <span>Caso finalizado: <strong><%= @evaluation.result.presence || @sa_case.status %></strong></span>
  <% if @can_reopen %>
    <%= form_tag("/service_assurance/cases/#{@sa_case.id}/reopen", method: :post, style: 'display:inline') do %><%= submit_tag 'Reabrir', class: 'sa-btn' %><% end %>
  <% end %>
</div>
<% end %>
<% end %>

<dialog id="dlg-accept" class="sa-dlg">
  <h3>Cerrar conciliación como reconocida</h3>
  <p class="sa-hint">Fecha y tiempo obligatorios: quedan registrados en el cierre.</p>
  <label>Fecha reporte / envío *</label><input type="date" id="dlg-acc-date" required>
  <label>Tiempo reconocido (min) *</label><input type="number" id="dlg-acc-min" required>
  <menu>
    <button type="button" id="dlg-acc-ok" class="sa-btn primary">Confirmar cierre</button>
    <button type="button" id="dlg-acc-cancel" class="sa-btn">Cancelar</button>
  </menu>
</dialog>
<dialog id="dlg-reject" class="sa-dlg">
  <h3>Cerrar conciliación como rechazada</h3>
  <p class="sa-hint">Motivo obligatorio. El tiempo solo si hubo reconocimiento parcial.</p>
  <label>Motivo del rechazo *</label><textarea id="dlg-rej-motivo" rows="3" required></textarea>
  <label>Tiempo reconocido (min, si aplica)</label><input type="number" id="dlg-rej-min">
  <menu>
    <button type="button" id="dlg-rej-ok" class="sa-btn primary">Confirmar cierre</button>
    <button type="button" id="dlg-rej-cancel" class="sa-btn">Cancelar</button>
  </menu>
</dialog>
<dialog id="dlg-discard" class="sa-dlg">
  <h3>Marcar como no aplica</h3>
  <p class="sa-hint">Motivo obligatorio. Se limpia la decisión de ANS.</p>
  <label>Motivo *</label><textarea id="dlg-dis-motivo" rows="3" required></textarea>
  <menu>
    <button type="button" id="dlg-dis-ok" class="sa-btn primary">Confirmar</button>
    <button type="button" id="dlg-dis-cancel" class="sa-btn">Cancelar</button>
  </menu>
</dialog>

<section id="sa-audit" style="display:none">
<h3>Auditoría</h3>
<table class="list">
  <thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Campo</th><th>Antes</th><th>Después</th></tr></thead>
  <tbody>
  <% @audits.each do |a| %>
    <tr><td><%= format_time(a.created_at) %></td><td><%= a.user_id %></td><td><%= a.action %></td><td><%= a.field_name %></td><td><%= truncate(a.old_value.to_s, length: 60) %></td><td><%= truncate(a.new_value.to_s, length: 60) %></td></tr>
  <% end %>
  </tbody>
</table>
</section>
</div>
<script>
function saMin(a,b){if(!a||!b)return null;var ms=new Date(b)-new Date(a);if(isNaN(ms)||ms<=0)return null;return Math.round(ms/60000);}
function saHuman(m){if(m==null)return '—';var h=Math.floor(m/60);return h>0?h+'h '+(m%60)+'m ('+m+' min)':m+' min';}
function saToLocal(v){if(!v)return '';var d=new Date(v.replace(' ','T'));if(isNaN(d))return '';var p=function(n){return (n<10?'0':'')+n;};return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+'T'+p(d.getHours())+':'+p(d.getMinutes());}
function saEl(id){return document.getElementById(id);}
function saCalc(){
  var cs=saEl('ev-contract-start'),ce=saEl('ev-contract-end');
  var cm=saMin(cs&&cs.value,ce&&ce.value);
  var cc=saEl('calc-contract');if(cc)cc.textContent=(cm==null)?'—':cm+' min';
  var ch=saEl('calc-contract-h');if(ch)ch.textContent=saHuman(cm);
  var dtEl=saEl('ev-downtime');
  if(cm!=null&&dtEl)dtEl.value=cm;
  var ak=parseInt(((saEl('ev-ack'))||{}).value,10);
  var df=saEl('ev-diff');
  var dv=(cm!=null&&!isNaN(ak))?(cm-ak):parseInt((df||{}).value,10);
  var cd=saEl('calc-diff');if(cd)cd.textContent=(!isNaN(dv)&&dv!=null)?(dv+' min'):'—';
  if(cm!=null&&!isNaN(ak)&&df)df.value=cm-ak;
}
var saTimer=null;
function saAutosave(){
  var badge=document.getElementById('sa-saved');
  badge.textContent='Guardando…';
  var form=document.getElementById('sa-form');
  var fd=new FormData(form);
  fd.append('transition','save');
  var token=(document.querySelector('meta[name=csrf-token]')||{}).content;
  fetch(form.action,{method:'PATCH',body:fd,credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest','X-CSRF-Token':token||''}})
    .then(function(r){return r.json();})
    .then(function(j){
      if(j.ok){
        badge.textContent='Guardado '+j.saved_at;
        if(j.lock_version!=null)document.getElementById('ev-lock').value=j.lock_version;
        if(j.downtime!=null)document.getElementById('ev-downtime').value=j.downtime;
        if(j.difference!=null)document.getElementById('ev-diff').value=j.difference;
        saApplyTabs(j.tab_states);
        saCalc();
      }else{badge.textContent='Error: '+(j.error||'no guardado');}
    })
    .catch(function(){badge.textContent='Sin conexión: no guardado';});
}
document.getElementById('sa-form').addEventListener('input',function(){saCalc();clearTimeout(saTimer);saTimer=setTimeout(saAutosave,1500);});
var pullBoth=document.getElementById('pull-both');
if(pullBoth){pullBoth.addEventListener('click',function(){
  var f=document.getElementById('sa-form');
  var vs=saToLocal(f.getAttribute('data-ticket-start'));
  var ve=saToLocal(f.getAttribute('data-ticket-end'));
  if(vs)document.getElementById('ev-contract-start').value=vs;
  if(ve)document.getElementById('ev-contract-end').value=ve;
  saCalc();saAutosave();
});}
function saApplyTabs(ts){
  if(!ts)return;
  var map={'a':'panel-a','b':'panel-b','d':'panel-d','f':'panel-f'};
  Object.keys(map).forEach(function(k){
    var btn=document.querySelector('.sa-tabbar button[data-tab="'+map[k]+'"]');
    if(!btn)return;
    btn.classList.remove('ok','todo');
    btn.classList.add(ts[k]?'ok':'todo');
  });
}
function saNowLocal(){var d=new Date();var p=function(n){return (n<10?'0':'')+n;};return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+'T'+p(d.getHours())+':'+p(d.getMinutes());}
function saLimits(){
  var f=document.getElementById('sa-form');
  var t0=saToLocal(f.getAttribute('data-ticket-start'))||'';
  var now=saNowLocal();
  ['ev-contract-start','ev-contract-end'].forEach(function(id){
    var el=document.getElementById(id);
    if(el){if(t0)el.min=t0;el.max=now;}
  });
}
document.querySelectorAll('.sa-flow button[data-t]').forEach(function(b){
  b.addEventListener('click',function(){document.getElementById('sa-transition').value=b.getAttribute('data-t');});
});
var dlgA=document.getElementById('dlg-accept'),dlgR=document.getElementById('dlg-reject'),dlgD=document.getElementById('dlg-discard');
var btnA=document.getElementById('btn-accept'),btnR=document.getElementById('btn-reject'),btnD=document.getElementById('btn-discard');
if(btnA){btnA.addEventListener('click',function(){
  document.getElementById('dlg-acc-date').value=(document.querySelector('[name="evaluation[reported_on]"]')||{}).value||'';
  document.getElementById('dlg-acc-min').value=(document.getElementById('ev-ack')||{}).value||'';
  dlgA.showModal();
});}
if(btnR){btnR.addEventListener('click',function(){
  document.getElementById('dlg-rej-motivo').value=(document.querySelector('[name="evaluation[conciliation_notes]"]')||{}).value||'';
  document.getElementById('dlg-rej-min').value=(document.getElementById('ev-ack')||{}).value||'';
  dlgR.showModal();
});}
document.getElementById('dlg-acc-cancel').addEventListener('click',function(){dlgA.close();});
document.getElementById('dlg-rej-cancel').addEventListener('click',function(){dlgR.close();});
if(btnD){btnD.addEventListener('click',function(){
  document.getElementById('dlg-dis-motivo').value=(document.querySelector('[name="evaluation[conciliation_notes]"]')||{}).value||'';
  dlgD.showModal();
});}
document.getElementById('dlg-dis-cancel').addEventListener('click',function(){dlgD.close();});
document.getElementById('dlg-dis-ok').addEventListener('click',function(){
  var mo=document.getElementById('dlg-dis-motivo').value;
  if(!mo.trim()){alert('Indique el motivo');return;}
  var form=document.getElementById('sa-form');
  var notes=form.querySelector('[name="evaluation[conciliation_notes]"]');
  if(!notes){notes=document.createElement('textarea');notes.name='evaluation[conciliation_notes]';notes.style.display='none';form.appendChild(notes);}
  notes.value=mo;
  dlgD.close();
  document.getElementById('sa-transition').value='discard';
  form.submit();
});
document.getElementById('dlg-acc-ok').addEventListener('click',function(){
  var d=document.getElementById('dlg-acc-date').value,m=document.getElementById('dlg-acc-min').value;
  if(!d){alert('Indique la fecha de reporte / envío');return;}
  if(m===''){alert('Indique el tiempo reconocido');return;}
  var rep=document.querySelector('[name="evaluation[reported_on]"]'),ack=document.getElementById('ev-ack');
  if(rep&&d)rep.value=d;
  if(ack&&m!=='')ack.value=m;
  dlgA.close();
  document.getElementById('sa-transition').value='close_accepted';
  document.getElementById('sa-form').submit();
});
document.getElementById('dlg-rej-ok').addEventListener('click',function(){
  var mo=document.getElementById('dlg-rej-motivo').value,m=document.getElementById('dlg-rej-min').value;
  if(!mo.trim()){alert('Indique el motivo del rechazo');return;}
  var notes=document.querySelector('[name="evaluation[conciliation_notes]"]'),ack=document.getElementById('ev-ack');
  if(notes)notes.value=mo;
  if(ack&&m!=='')ack.value=m;
  dlgR.close();
  document.getElementById('sa-transition').value='close_rejected';
  document.getElementById('sa-form').submit();
});
saCalc();
saLimits();
var saAuditT=document.getElementById('sa-audit-toggle');
if(saAuditT){saAuditT.addEventListener('click',function(e){
  e.preventDefault();
  var s=document.getElementById('sa-audit');
  var show=s.style.display==='none';
  s.style.display=show?'':'none';
  saAuditT.textContent=show?'Ocultar auditoría':'Ver auditoría';
  if(show)s.scrollIntoView();
});}
document.querySelectorAll('.sa-tabbar button').forEach(function(btn){
  btn.addEventListener('click',function(){
    document.querySelectorAll('.sa-tabbar button').forEach(function(b){b.classList.remove('active');});
    document.querySelectorAll('.sa-panel').forEach(function(p){p.classList.remove('active');});
    btn.classList.add('active');
    document.getElementById(btn.getAttribute('data-tab')).classList.add('active');
  });
});
</script>
