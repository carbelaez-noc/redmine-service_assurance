<style>
.sa-tabbar{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0}
.sa-tabbar button{padding:6px 14px;border:1px solid #ccc;border-bottom:none;border-radius:6px 6px 0 0;cursor:pointer;background:#f5f5f5;font-weight:bold}
.sa-tabbar button.todo{background:#f8d7da;border-color:#f5c6cb;color:#721c24}
.sa-tabbar button.ok{background:#d4edda;border-color:#c3e6cb;color:#155724}
.sa-tabbar button.active{box-shadow:inset 0 3px 0 #2b7cd3}
.sa-panel{display:none;border:1px solid #ccc;padding:12px;border-radius:0 6px 6px 6px;background:#fff}
.sa-panel.active{display:block}
.sa-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:8px 16px}
.sa-grid .full{grid-column:1/-1}
.sa-grid label{display:block;font-weight:bold;margin-bottom:2px}
.sa-grid input,.sa-grid select,.sa-grid textarea{width:100%;max-width:100%;box-sizing:border-box}
.sa-grid input[readonly]{background:#f4f4f4}
.sa-calc{background:#eef4fb;border:1px solid #b8d4f0;border-radius:4px;padding:6px 10px;margin:8px 0}
.sa-journal{margin:6px 0;border:1px solid #e0e0e0;border-radius:4px}
.sa-journal summary{cursor:pointer;padding:4px 8px;background:#f7f7f7}
.sa-journal .wiki{padding:4px 8px}
.sa-flow{margin-top:10px;padding-top:8px;border-top:1px solid #ddd;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
#sa-saved{color:#155724;font-weight:bold}
@media (max-width:800px){.sa-grid{grid-template-columns:1fr}}
</style>
<h2>Service Assurance — Caso #<%= @sa_case.id %> (ticket <%= link_to issue_folio(@issue), issue_path(@issue) %>)</h2>
<p><%= link_to '← Volver a la bandeja', service_assurance_path %> · <%= link_to 'Ver todos los casos', '/service_assurance?sa_status=' %></p>
<p><strong>Estado SA:</strong> <%= @sa_case.status %> · <strong>Evaluador:</strong> <%= @sa_case.assignee ? @sa_case.assignee.login : '—' %> · <strong>Antigüedad:</strong> <%= @sa_case.age_days ? "#{@sa_case.age_days} días" : '—' %> · <strong>Ticket:</strong> <%= issue_folio(@issue) %> — <%= @issue.subject %> (<%= @issue.status.name %> · <%= @issue.project.name %>)</p>

<div class="sa-tabs">
<div class="sa-tabbar">
<button type="button" data-tab="panel-a" class="<%= @tab_states[:a] ? 'ok' : 'todo' %> active">A. Ticket</button>
<button type="button" data-tab="panel-b" class="<%= @tab_states[:b] ? 'ok' : 'todo' %>">B. Evaluación</button>
<button type="button" data-tab="panel-c" class="<%= @tab_states[:c] ? 'ok' : 'todo' %>">C. Contractual</button>
<button type="button" data-tab="panel-d" class="<%= @tab_states[:d] ? 'ok' : 'todo' %>">D. Conciliación</button>
<button type="button" data-tab="panel-f" class="ok">Auditoría</button>
</div>

<section class="sa-panel active" id="panel-a">
<h3>A. Información original del ticket (solo lectura)</h3>
<div class="box">
  <p><strong>Asunto:</strong> <%= @issue.subject %></p>
  <p><strong>Proyecto/Tracker:</strong> <%= @issue.project.name %> / <%= @issue.tracker.name %> · <strong>Cierre:</strong> <%= format_time(@issue.closed_on) %></p>
  <% snap = @sa_case.original_snapshot || {} %>
  <% if snap.any? %>
  <table class="list">
    <thead><tr><th>Dato original</th><th>Valor al abrir la evaluación</th></tr></thead>
    <tbody>
    <% { 'ciudad' => 'Ciudad', 'inicio' => 'Inicio de falla', 'fin' => 'Fin de falla', 'clientes' => 'Clientes afectados', 'carrier' => 'Carrier', 'caso_isp' => '# Caso ISP', 'categoria' => 'Categoría', 'subcategoria' => 'Subcategoría', 'motivo' => 'Motivo', 'id_externo' => 'ID externo' }.each do |key, label| %>
      <% raw = snap.dig(key, 'raw') %>
      <tr><td><%= label %></td><td><%= FibrazoServiceAssurance::PreloadMap.display(raw) %></td></tr>
    <% end %>
    </tbody>
  </table>
  <% end %>
  <p><strong>Descripción:</strong></p>
  <div class="wiki"><%= textilizable(@issue.description) %></div>
  <% if @journals.any? %>
  <p><strong>Notas del ticket (<%= @journals.size %>, clic para expandir):</strong></p>
  <% @journals.each do |j| %>
    <details class="sa-journal"><summary><%= j.user ? j.user.login : '?' %> — <%= format_time(j.created_on) %></summary><div class="wiki"><%= textilizable(j.notes) %></div></details>
  <% end %>
  <% end %>
  <% if @attachments.any? %>
  <p><strong>Adjuntos (<%= @attachments.size %>):</strong>
  <% @attachments.each do |a| %><%= link_to a.filename, attachment_path(a) %> <% end %></p>
  <% end %>
</div>
</section>

<%= form_for :evaluation, url: "/service_assurance/cases/#{@sa_case.id}", html: { method: :patch, id: 'sa-form' } do |f| %>
<%= f.hidden_field :lock_version, value: @evaluation.lock_version %>
<section class="sa-panel" id="panel-b">
<h3>B. Evaluación técnica (precargada, confirmable)</h3>
<div class="sa-calc">Duración real: <strong id="calc-real">—</strong> · Clientes: <strong><%= @evaluation.affected_customers || '—' %></strong></div>
<div class="sa-grid">
  <div><label>Proveedor (inventario carrier)</label><%= f.select :provider, [['— seleccionar —', '']] + @carriers.map { |c| [c, c] }, selected: @evaluation.provider %></div>
  <div><label>Número de escalamiento carrier</label><%= f.text_field :external_case, value: @evaluation.external_case %></div>
  <div><label>Verificación del escalamiento</label><%= f.select :external_verified, %w[pendiente verificado discrepancia], selected: @evaluation.external_verified %></div>
  <div><label>Tipo de afectación</label><%= f.text_field :impact_type, value: @evaluation.impact_type %></div>
  <div><label>Inicio real</label><%= f.datetime_field :real_start_at, value: @evaluation.real_start_at, id: 'ev-real-start' %></div>
  <div><label>Fin real</label><%= f.datetime_field :real_end_at, value: @evaluation.real_end_at, id: 'ev-real-end' %></div>
  <div><label>Clientes afectados</label><%= f.number_field :affected_customers, value: @evaluation.affected_customers %></div>
  <div class="full"><label>Observaciones extensas</label><%= f.text_area :observations, value: @evaluation.observations, rows: 4 %></div>
</div>
</section>

<section class="sa-panel" id="panel-c">
<h3>C. Decisión contractual</h3>
<div class="sa-calc">Duración a objetar: <strong id="calc-contract">—</strong> · Se calcula sola desde el rango contractual al guardar.</div>
<div class="sa-grid">
  <div><label>¿Aplica ANS?</label><%= f.select :ans_applies, [['—', ''], ['Sí', true], ['No', false]], selected: @evaluation.ans_applies.nil? ? '' : @evaluation.ans_applies %></div>
  <div><label>Fecha de reporte al proveedor</label><%= f.date_field :reported_on, value: @evaluation.reported_on %></div>
  <div><label>Inicio de indisponibilidad a objetar</label><%= f.datetime_field :contract_start_at, value: @evaluation.contract_start_at, id: 'ev-contract-start' %></div>
  <div><label>Fin de indisponibilidad a objetar</label><%= f.datetime_field :contract_end_at, value: @evaluation.contract_end_at, id: 'ev-contract-end' %></div>
  <div><label>Indisponibilidad computable (min, automática)</label><%= f.number_field :downtime_minutes, value: @evaluation.downtime_minutes, id: 'ev-downtime', readonly: true %></div>
  <div class="full"><label>Exclusiones</label><%= f.text_area :exclusions, value: @evaluation.exclusions, rows: 2 %></div>
</div>
<p><em>Si aplica ANS, la conciliación queda marcada automáticamente (sin segundo campo).</em></p>
</section>

<section class="sa-panel" id="panel-d">
<h3>D. Conciliación</h3>
<% if @evaluation.conciliation_applies != true %>
<div class="sa-calc">La conciliación se habilita al marcar <strong>¿Aplica ANS? = Sí</strong> en la pestaña C.</div>
<% end %>
<div class="sa-calc">Diferencia (computable − reconocido): <strong id="calc-diff">—</strong> · Se calcula sola al guardar.</div>
<div class="sa-grid">
  <div><label>Fecha de envío al proveedor</label><%= f.date_field :sent_on, value: @evaluation.sent_on %></div>
  <div><label>Tiempos reconocidos (min)</label><%= f.number_field :acknowledged_minutes, value: @evaluation.acknowledged_minutes, id: 'ev-ack' %></div>
  <div><label>Diferencia (min, automática)</label><%= f.number_field :difference_minutes, value: @evaluation.difference_minutes, id: 'ev-diff', readonly: true %></div>
  <div><label>Créditos reconocidos</label><%= f.number_field :credit_granted, value: @evaluation.credit_granted, step: 0.01 %></div>
  <div><label>Resultado</label><strong><%= @evaluation.result.presence || 'pendiente' %></strong></div>
  <div class="full"><label>Motivo / observaciones de cierre</label><%= f.text_area :conciliation_notes, value: @evaluation.conciliation_notes, rows: 3 %></div>
</div>
</section>

<div class="sa-flow">
<%= button_tag 'Guardar avance', type: 'submit', name: 'transition', value: 'save' %>
<%= button_tag 'Enviar a revisión', type: 'submit', name: 'transition', value: 'to_review' %>
<%= button_tag 'Enviar a conciliación', type: 'submit', name: 'transition', value: 'to_conciliate' %>
<%= button_tag 'No aplica', type: 'submit', name: 'transition', value: 'discard', data: { confirm: 'Marcar como no aplica?' } %>
<%= button_tag 'Cerrar: reconocida', type: 'submit', name: 'transition', value: 'close_accepted', data: { confirm: 'Cerrar conciliación como reconocida?' } %>
<%= button_tag 'Cerrar: rechazada', type: 'submit', name: 'transition', value: 'close_rejected', data: { confirm: 'Cerrar conciliación como rechazada? Deje el motivo.' } %>
<span id="sa-saved"></span>
</div>
<% end %>

<section class="sa-panel" id="panel-f">
<h3>Auditoría</h3>
<table class="list">
  <thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Campo</th><th>Antes</th><th>Después</th></tr></thead>
  <tbody>
  <% @audits.each do |a| %>
    <tr><td><%= format_time(a.created_at) %></td><td><%= a.user_id %></td><td><%= a.action %></td><td><%= a.field_name %></td><td><%= truncate(a.old_value.to_s, length: 60) %></td><td><%= truncate(a.new_value.to_s, length: 60) %></td></tr>
  <% end %>
  </tbody>
</table>
</section>
</div>
<script>
function saMin(a,b){if(!a||!b)return null;var ms=new Date(b)-new Date(a);if(isNaN(ms)||ms<=0)return null;return Math.round(ms/60000);}
function saHuman(m){if(m==null)return '—';var h=Math.floor(m/60);return h>0?h+'h '+(m%60)+'m ('+m+' min)':m+' min';}
function saCalc(){
  var rs=document.getElementById('ev-real-start'),re=document.getElementById('ev-real-end');
  var cs=document.getElementById('ev-contract-start'),ce=document.getElementById('ev-contract-end');
  document.getElementById('calc-real').textContent=saHuman(saMin(rs&&rs.value,re&&re.value));
  document.getElementById('calc-contract').textContent=saHuman(saMin(cs&&cs.value,ce&&ce.value));
  var dt=parseInt((document.getElementById('ev-downtime')||{}).value,10);
  var ak=parseInt((document.getElementById('ev-ack')||{}).value,10);
  document.getElementById('calc-diff').textContent=(!isNaN(dt)&&!isNaN(ak))?((dt-ak)+' min'):'—';
}
var saTimer=null;
function saAutosave(){
  var badge=document.getElementById('sa-saved');
  badge.textContent='Guardando…';
  var form=document.getElementById('sa-form');
  var fd=new FormData(form);
  fd.append('transition','save');
  var token=(document.querySelector('meta[name=csrf-token]')||{}).content;
  fetch(form.action,{method:'PATCH',body:fd,credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest','X-CSRF-Token':token||''}})
    .then(function(r){return r.json();})
    .then(function(j){
      if(j.ok){
        badge.textContent='Guardado '+j.saved_at;
        if(j.downtime!=null)document.getElementById('ev-downtime').value=j.downtime;
        if(j.difference!=null)document.getElementById('ev-diff').value=j.difference;
        saCalc();
      }else{badge.textContent='Error: '+(j.error||'no guardado');}
    })
    .catch(function(){badge.textContent='Sin conexión: no guardado';});
}
document.getElementById('sa-form').addEventListener('input',function(){saCalc();clearTimeout(saTimer);saTimer=setTimeout(saAutosave,1500);});
saCalc();
document.querySelectorAll('.sa-tabbar button').forEach(function(btn){
  btn.addEventListener('click',function(){
    document.querySelectorAll('.sa-tabbar button').forEach(function(b){b.classList.remove('active');});
    document.querySelectorAll('.sa-tabs .sa-panel').forEach(function(p){p.classList.remove('active');});
    btn.classList.add('active');
    document.getElementById(btn.getAttribute('data-tab')).classList.add('active');
  });
});
</script>
